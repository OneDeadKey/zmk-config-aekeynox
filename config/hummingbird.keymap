/ {
  // Kscan that goes against the diode direction, in order to have keys that
  // will never get triggered. That way, we can pad out the matrix to fit into
  // a 34-keys keeb, which are the smallest keebs currently supported by Selenium
  kscan_impossible: kscan_impossible {
    compatible = "zmk,kscan-gpio-matrix";
    diode-direction = "row2col";

    col-gpios
      = <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
      , <&xiao_d 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
      , <&xiao_d 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
      , <&xiao_d 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
      ;

    row-gpios = <&xiao_d 0 GPIO_ACTIVE_HIGH>;
  };

  padded_kscan: padded_kscan {
    compatible = "zmk,kscan-composite";
    rows = <7>;
    columns = <7>;

    base-scan {
      kscan = <&kscan0>;
    };

    padding {
      kscan = <&kscan_impossible>;
      row-offset = <6>;
    };
  };
};

&matrix_transform0 {
    compatible = "zmk,matrix-transform";
    columns = <7>;
    rows = <7>;
    map = <
RC(0,0) RC(1,0) RC(0,1) RC(1,1) RC(0,2)   RC(1,2) RC(0,3) RC(1,3) RC(0,4) RC(1,4)
RC(2,0) RC(3,0) RC(2,1) RC(3,1) RC(2,2)   RC(3,2) RC(2,3) RC(3,3) RC(2,4) RC(3,4)
RC(6,0) RC(4,0) RC(5,0) RC(4,1) RC(6,1)   RC(6,2) RC(5,2) RC(4,3) RC(5,3) RC(6,3)
                     RC(5,1) RC(4,2)         RC(5,4) RC(4,4)
    >;
};

#define SELENIUM_KEYMAP_BINDINGS(LOUT1,  LROW1,  RROW1,  ROUT1, \
                                 LOUT2,  LROW2,  RROW2,  ROUT2, \
                                 LOUT3,  LROW3,  RROW3,  ROUT3, \
                                 LT1, LT2, LT3,  RT3, RT2, RT1) \
      LROW1   RROW1 \
      LROW2   RROW2 \
      LROW3   RROW3 \
    LT1 LT2   RT2 RT1

// This keyboard has only two keys per thumb.
// Ensure the 2TK flavor is selected.
#define FOUR_THUMB_KEYS

// Force hummingbird layout for any compatible layout
#define HUMMINGBIRD

#include <aekeynox/selenium.keymap>
